# Copy this file to .env and fill in your key. Never commit .env.
XAI_API_KEY=your-xai-api-key-here

# Model name from https://docs.x.ai/developers/models (check the current list)
XAI_MODEL=grok-4.7
XAI_BASE_URL=https://api.x.ai/v1

# Seconds to wait for Grok before giving up
XAI_TIMEOUT=55

# Comma-separated origins allowed to call this API. "*" allows any (fine for local use).
CORS_ORIGINS=*

# Max characters of guideline text sent to Grok per request
GUIDELINE_CONTEXT_CHARS=80000
MAX_UPLOAD_MB=20
